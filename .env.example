# Application-side Azure OpenAI configuration for Agent Framework and Mem0.
# Notebook 1 and database-side retrieval use HorizonDB AI Model Management aliases.

AZURE_OPENAI_ENDPOINT=https://<your-ai-foundry-resource>.services.ai.azure.com/openai/v1/responses
AZURE_OPENAI_KEY=<your-azure-openai-key>
AZURE_OPENAI_DEPLOYMENT=<your-chat-deployment-name>
AZURE_EMBED_DEPLOYMENT=text-embedding-3-small
AZURE_API_VERSION=

# Azure HorizonDB connection
DB_HOST=<your-horizondb-server>.horizondb.azure.com
DB_NAME=postgres
DB_USER=<your-db-user>
PGPASSWORD=<your-db-password>
AZURE_PG_PORT=5432
AZURE_PG_SSLMODE=require
